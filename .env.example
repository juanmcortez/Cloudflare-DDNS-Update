# Here you input your Cloudflare credentials.
#
# Preferred: create a scoped API Token in the Cloudflare dashboard
# (My Profile > API Tokens > Create Token) with "Zone" > "DNS" > "Edit"
# permissions for the zones you want to update, then paste it below.
API_TOKEN=

# Deprecated fallback: the legacy Global API Key + Email pair. Only used
# when API_TOKEN is empty. Prefer API_TOKEN above for better security.
GLOBAL_API_KEY=
EMAIL=


# Here you select your favourite IP discovery service
# We are using ipify as an example.
#
# IP4_VAL (required) is used to detect your public IPv4 address and keep
# any "A" DNS records in sync.
#
# IP6_VAL (optional) is used to detect your public IPv6 address and keep
# any "AAAA" DNS records in sync. If your server/network doesn't have IPv6
# connectivity, or you don't want AAAA records managed, either leave this
# blank or leave it pointing at an IPv6-only service - a failed/empty
# lookup is treated as "no IPv6 available" and AAAA records are simply
# skipped, so IPv4-only setups keep working exactly as before.
IP4_VAL="https://api.ipify.org"
IP6_VAL="https://api6.ipify.org"


# Here you can enter all the dns info from cloudflare parked domains. You will
# only need the domain name and the Zone ID found on the page for the domain.
# Refer to documentation for more detail
DOMAIN_1=
ZONEID_1=

DOMAIN_2=
ZONEID_2=

DOMAIN_3=
ZONEID_3=

DOMAIN_4=
ZONEID_4=

DOMAIN_5=
ZONEID_5=

